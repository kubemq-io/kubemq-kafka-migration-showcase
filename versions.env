# Pinned versions for the Kafka -> KubeMQ migration showcase.
# Sourced by the Makefile, scripts/*.sh and passed to Terraform by the Makefile as -var (infra-up, down).
# Change a pin here, nowhere else.

# kmq CLI release (public installer: https://raw.githubusercontent.com/kubemq-io/kmq/main/install.sh).
# Chart, operator and server pins come from this kmq's `deploy prepare` defaults.
KMQ_VERSION=v3.6.14

# Apache Kafka tarball: kafka_${KAFKA_SCALA}-${KAFKA_VERSION}.tgz
KAFKA_VERSION=4.3.1
KAFKA_SCALA=2.13
# Hash from https://dlcdn.apache.org/kafka/4.3.1/kafka_2.13-4.3.1.tgz.sha512 — Apache publishes it as
# "<file>: XXXX XXXX ..." (uppercase, space-grouped, 3 lines); store it here as ONE bare lowercase hex string.
KAFKA_SHA512=c7d7b2318cb51aa0c61d3246a51c349210073c5c9b754947ef965a439f2f939e8600f204e134a75ac31faf3829c9370960ef7c6a9886c8a1dbf0339a21f4c54c

# Laptop tool minimums checked by scripts/preflight.sh (GO_MIN: franz-go v1.22 requires go 1.26)
TERRAFORM_MIN=1.6
GO_MIN=1.26
KCAT_MIN=1.7
