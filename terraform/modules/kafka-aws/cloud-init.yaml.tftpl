#cloud-config
# Rendered by Terraform (terraform/modules/kafka-aws). Writes the node contract
# consumed by scripts/kafka/bootstrap-node.sh and configure-broker.sh, then
# installs a systemd oneshot that runs them on every boot.
write_files:
  - path: /etc/kafka-showcase/node.env
    owner: root:root
    permissions: "0644"
    content: |
      ROLE=${role}
%{ if role == "broker" ~}
      NODE_ID=${node_id}
%{ endif ~}
      CLUSTER_ID=${cluster_id}
      INTERNAL_IP=${internal_ip}
      EXTERNAL_IP=${external_ip}
      VOTERS=${voters}
      KAFKA_VERSION=${kafka_version}
      KAFKA_SHA512=${kafka_sha512}
      NVME_MODEL_REGEX="${nvme_model_regex}"
      MOUNT_NVME=${mount_nvme}
  - path: /opt/kafka-showcase/bootstrap-node.sh
    owner: root:root
    permissions: "0755"
    encoding: b64
    content: ${bootstrap_node_b64}
  - path: /opt/kafka-showcase/configure-broker.sh
    owner: root:root
    permissions: "0755"
    encoding: b64
    content: ${configure_broker_b64}
  - path: /etc/systemd/system/kafka-showcase-setup.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Kafka showcase node setup (bootstrap + broker configure)
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      EnvironmentFile=/etc/kafka-showcase/node.env
      ExecStart=/opt/kafka-showcase/bootstrap-node.sh
      ExecStart=/bin/bash -c 'if [ "$ROLE" = "broker" ]; then exec /opt/kafka-showcase/configure-broker.sh; fi'

      [Install]
      WantedBy=multi-user.target
runcmd:
  - systemctl daemon-reload
  - systemctl enable --now kafka-showcase-setup.service
