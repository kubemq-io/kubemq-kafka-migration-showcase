# Copy to terraform.tfvars and edit. Never commit terraform.tfvars.
# `make addons-up` passes region and cluster_name from the infra root's outputs; set them
# here only when running terraform directly:
# region       = "us-east-1"
# cluster_name = "kmq-showcase-eks"
# aws_profile = "my-profile"

kubemq_namespace    = "kubemq"
kubemq_release_name = "kubemq"

# Exactly one of the two:
kubemq_license_key = "paste-your-license-key"
# kubemq_license_secret_name = "kubemq-license"
